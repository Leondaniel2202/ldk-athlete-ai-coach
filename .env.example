APP_NAME=ldk-athlete-ai-coach
APP_ENV=local
DEBUG=true

POSTGRES_DB=ldk_athlete_ai_coach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

NOTION_API_KEY=secret_your_notion_api_key
NOTION_PLAN_DATA_SOURCE_ID=your_plan_data_source_id
NOTION_PHASE_DATA_SOURCE_ID=your_phase_data_source_id
NOTION_WORKOUT_DATA_SOURCE_ID=your_workout_data_source_id
